@echo off
chcp 65001 >nul
title Робот расчёта бонусов
cd /d "%~dp0"

echo ==========================================================
echo         РОБОТ РАСЧЁТА БОНУСОВ  (выполнение плана)
echo ==========================================================
echo.
echo Период по умолчанию берётся из листа "Спр_Параметры" книги ТП.xlsx.
set /p PER="Введите период ГГГГ-ММ и Enter (или просто Enter): "
echo.

if "%PER%"=="" (
    python "bonus_robot.py" --config "ТП.xlsx"
) else (
    python "bonus_robot.py" --config "ТП.xlsx" --period %PER%
)

echo.
echo ==========================================================
echo  Готово. Итоговые файлы — в папке "Результат\%PER%".
echo ==========================================================
pause